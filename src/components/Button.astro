---
interface Props { href: string; variant?: 'primary' | 'secondary'; newTab?: boolean }
const { href, variant = 'primary', newTab = true } = Astro.props;
---
<a class:list={['btn', variant]} href={href} target={newTab ? '_blank' : undefined} rel={newTab ? 'noopener noreferrer' : undefined}>
  <slot />
</a>
<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px 12px;
    border-radius: 12px;
    font-size: 14px;
    line-height: 22.5px;
    transition:
      background-color var(--spring-snappy-d) var(--spring-snappy),
      border-color var(--spring-snappy-d) var(--spring-snappy),
      transform var(--spring-snappy-d) var(--spring-snappy);
  }
  .primary {
    color: var(--white);
    background: var(--n-15);
    border: 1.5px solid var(--n-20);
  }
  .secondary {
    color: var(--n-50);
    background: var(--n-96);
    padding: 6px 10px;
    font-family: var(--font-display);
    font-weight: 500;
    box-shadow:
      inset 0 -2px 0 0 var(--n-90),
      inset 0 1px 0 0 var(--n-90),
      inset 1px 0 0 0 var(--n-90),
      inset -1px 0 0 0 var(--n-90);
  }
  @media (hover: hover) {
    .primary:hover {
      background: var(--n-20);
      border-color: var(--n-30);
    }
    .secondary:hover {
      background: var(--n-94);
    }
  }
  .btn:active {
    transform: scale(0.97);
  }
</style>
