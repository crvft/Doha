---
interface Props { href: string; label?: string }
const { href, label = 'Back' } = Astro.props;
---
<a class="back" href={href}>
  <svg class="chev" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path d="M15 18l-6-6 6-6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <span>{label}</span>
</a>
<style>
  .back {
    position: relative;
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-size: 18px;
    line-height: 23px;
    color: var(--n-10);
  }
  .chev {
    position: absolute;
    left: -22px;
    width: 18px;
    height: 18px;
    transition: transform 0.2s linear;
  }
  @media (hover: hover) {
    .back:hover .chev {
      transform: translateX(-4px);
    }
  }
</style>
