---
interface Props { lead: string; link: string; href: string; class?: string }
const { lead, link, href, class: cls } = Astro.props;
---

<a class:list={['cta', cls]} href={href}>
  <span class="lead">{lead}</span><span class="dash"> —</span> <em>{link}</em>
  <svg class="chev" viewBox="0 0 24 24" width="20" height="22" aria-hidden="true">
    <path d="M9 18l6-6-6-6" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
</a>

<style>
  .cta {
    position: relative;
    align-self: flex-start;
    width: fit-content;
    display: inline-block;
    white-space: nowrap;
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 16px;
    color: var(--n-10);
    font-variation-settings: 'wght' 420, 'wdth' 95;
  }
  .dash {
    font-variation-settings: 'wght' 450, 'wdth' 100;
  }
  em {
    font-style: italic;
    font-variation-settings: 'wght' 450, 'wdth' 100;
  }
  .chev {
    position: absolute;
    top: 50%;
    right: -20px;
    margin-top: -12px;
    width: 20px;
    height: 22px;
    transition: transform var(--spring-snappy-d) var(--spring-snappy);
  }
  @media (hover: hover) {
    .cta:hover .chev {
      transform: translateX(4px);
    }
  }
  .cta:active .chev {
    transform: translateX(4px);
  }
</style>
