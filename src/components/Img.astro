---
/**
 * Optimised image. Takes a path string from content (e.g. "/src/assets/home/x.jpg"),
 * emits a WebP <img> with a responsive srcset, lazy by default.
 * (WebP only: for UI screenshots it beats AVIF on size and builds ~10x faster.)
 */
import { Image } from 'astro:assets';
import { resolveImage } from '@/lib/media';

interface Props {
  src?: string | null;
  alt?: string;
  sizes: string;
  /** Max rendered CSS width, used to cap generated widths (2x for retina). */
  maxWidth?: number;
  priority?: boolean;
  class?: string;
  style?: string;
}
const { src, alt = '', sizes, maxWidth = 1000, priority = false, class: cls, style } = Astro.props;
const image = resolveImage(src);
const candidates = [360, 480, 640, 750, 828, 1080, 1280, 1600, 1920, 2400];
const widths = image
  ? [...new Set([...candidates.filter((w) => w <= Math.min(maxWidth * 2, image.width)), Math.min(maxWidth * 2, image.width)])]
  : [];
---

{
  image && (
    <Image
      src={image}
      alt={alt}
      widths={widths}
      sizes={sizes}
      format="webp"
      quality={80}
      loading={priority ? 'eager' : 'lazy'}
      decoding={priority ? 'sync' : 'async'}
      fetchpriority={priority ? 'high' : 'auto'}
      class={cls}
      style={style}
    />
  )
}

