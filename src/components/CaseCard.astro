---
import Img from './Img.astro';
interface Props { href: string; number: string; date: string; title: string; summary: string; cover: string; priority?: boolean }
const { href, number, date, title, summary, cover, priority } = Astro.props;
---

<a class="card" href={href}>
  <div class="thumb">
    <Img src={cover} alt="" sizes="316px" maxWidth={316} priority={priority} />
  </div>
  <div class="text">
    <div class="meta"><span>{number}</span><span>{date}</span></div>
    <div class="copy">
      <h2>{title}</h2>
      <p>{summary}</p>
    </div>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 316px;
  }
  .thumb {
    position: relative;
    aspect-ratio: 316 / 229;
    border-radius: 20px;
    overflow: hidden;
    background: var(--n-96);
    transform: translateZ(0);
  }
  .thumb::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(244, 244, 244, 0.8);
    pointer-events: none;
  }
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition:
      filter var(--spring-slow-d) var(--spring-slow),
      transform var(--spring-slow-d) var(--spring-slow);
  }
  @media (hover: hover) {
    .card:hover .thumb :global(img),
    .card:focus-visible .thumb :global(img) {
      filter: grayscale(0);
      transform: scale(1.02);
    }
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 22px;
    color: var(--n-60);
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  h2 {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 20px;
    line-height: 24px;
    letter-spacing: -0.01em;
    color: var(--n-10);
    font-variation-settings: 'wght' 450, 'wdth' 100;
    text-wrap: pretty;
  }
  p {
    color: var(--n-45);
    text-wrap: pretty;
  }
  /* Tablet shows the colour images (as on the original site) */
  @media (max-width: 1199.98px) {
    .thumb :global(img) {
      filter: none;
    }
  }
</style>
