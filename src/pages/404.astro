---
import Base from '@/layouts/Base.astro';
import Logo from '@/components/Logo.astro';
---
<Base title="Page not found – Michael Okoye">
  <main class="nf">
    <a href="/" aria-label="Home"><Logo /></a>
    <h1>This page wandered off.</h1>
    <p><a href="/">Back to the homepage</a> or browse the <a href="/case-studies">case studies</a>.</p>
  </main>
</Base>
<style>
  .nf {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    text-align: center;
    padding: 16px;
  }
  h1 {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 24px;
    color: var(--n-10);
  }
  p a {
    color: var(--n-25);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
