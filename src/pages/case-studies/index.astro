---
import { getCollection, getEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Logo from '@/components/Logo.astro';
import CaseCard from '@/components/CaseCard.astro';
import { shortDate } from '@/lib/format';

const page = (await getEntry('caseStudiesPage', 'index'))!.data;
const entries = await getCollection('caseStudies', (e) => !e.data.draft);
const cards = [...entries].sort((a, b) => b.data.order - a.data.order || +b.data.date - +a.data.date);
const list = [...entries].sort((a, b) => +b.data.date - +a.data.date);
---

<Base title={`${page.title} – Michael Okoye`} description={page.description} preload={['/fonts/berkeley-mono-trial-regular.woff2']}>
  <header class="top">
    <a href="/" class="logo" aria-label="Home"><Logo class="logo-full" /><span class="lockup"><Logo mark /><span class="wordmark">mico / crvft</span></span></a>
    <div class="titles">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1>{page.title}</h1>
    </div>
  </header>

  <main class="content">
    <div class="intro">
      <p class="tags">
        {
          page.tags.map((t, i) => (
            <>
              {i > 0 && (
                <svg class="sep" width="11" height="19" viewBox="-1 -1 11 19" aria-hidden="true">
                  <path d="M1.176 14.148L6.048 2.08H7.224L2.352 14.148H1.176Z" fill="#989898" />
                </svg>
              )}
              <span>{t}</span>
            </>
          ))
        }
      </p>
      <p class="desc">{page.description}</p>
    </div>

    <div class="cards">
      {
        cards.map((e, i) => (
          <CaseCard
            href={`/case-studies/${e.id}`}
            number={e.data.number}
            date={shortDate(e.data.date)}
            title={e.data.cardTitle || e.data.title}
            summary={e.data.summary}
            cover={e.data.cover}
            priority={i < 3}
          />
        ))
      }
    </div>

    <ul class="list">
      {
        list.map((e) => (
          <li>
            <a href={`/case-studies/${e.id}`}>
              <span class="row-title">
                <svg class="arrow" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
                  <path d="M5.5 14.5l9-9M7 5.5h7.5V13" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>{e.data.shortTitle || e.data.cardTitle || e.data.title}</span>
              </span>
              <span class="row-date">{shortDate(e.data.date)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Base>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 5;
    height: 138px;
    padding: 0 16px 0 275px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--n-96);
  }
  .logo {
    position: absolute;
    left: 16px;
    top: 30px;
  }
  .lockup {
    display: none;
    align-items: center;
    gap: 8px;
  }
  .wordmark {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 16px;
    line-height: 24px;
    color: var(--n-10);
    font-variation-settings: 'wght' 500, 'wdth' 125;
  }
  .titles {
    padding: 30px 0 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 22px;
    color: var(--n-45);
  }
  h1 {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 36px;
    line-height: 54px;
    letter-spacing: -0.01em;
    color: var(--n-10);
    font-variation-settings: 'wght' 300, 'wdth' 100;
  }
  .content {
    padding: 24px 16px 32px 275px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .tags {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 22px;
    color: var(--n-70);
  }
  .sep {
    flex: none;
  }
  .desc {
    max-width: 413px;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 22px;
    color: var(--n-70);
    text-transform: uppercase;
  }
  .cards {
    display: flex;
    flex-wrap: wrap;
    gap: 39px 32px;
  }
  .list {
    display: none;
  }

  /* Tablet: centred header and grid */
  @media (max-width: 1199.98px) {
    .top {
      padding: 0 16px;
    }
    .titles {
      align-items: center;
      text-align: center;
    }
    .content {
      padding: 24px 16px 32px;
      align-items: center;
    }
    .intro {
      align-items: center;
      text-align: center;
    }
    .cards {
      justify-content: center;
      max-width: 690px;
    }
  }

  /* Phone: simple list */
  @media (max-width: 809.98px) {
    .top {
      position: static;
      height: auto;
      padding: 24px 0 0 16px;
      border: 0;
      background: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    .logo {
      position: static;
      display: block;
      width: fit-content;
    }
    :global(.logo-full) {
      display: none;
    }
    .lockup {
      display: flex;
    }
    .titles {
      align-items: flex-start;
      text-align: left;
      padding: 32px 0 0;
    }
    .eyebrow {
      display: none;
    }
    h1 {
      font-size: 22px;
      line-height: 22px;
      letter-spacing: -0.24px;
      font-variation-settings: 'wght' 410, 'wdth' 100;
    }
    .content {
      padding: 16px 0 32px;
      align-items: stretch;
      gap: 24px;
    }
    .intro {
      padding: 0 16px;
      align-items: flex-start;
      text-align: left;
      gap: 10px;
    }
    .desc {
      max-width: none;
    }
    .cards {
      display: none;
    }
    .list {
      display: block;
      list-style: none;
      margin: 0;
      padding: 0 12px;
    }
    .list a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      height: 53px;
      border-bottom: 1px solid var(--n-94);
      transition: background-color 0.2s var(--ease-out);
    }
    .list a:active {
      background: var(--n-98);
    }
    .row-title {
      display: flex;
      align-items: center;
      gap: 6px;
      min-width: 0;
      color: var(--n-10);
      font-size: 14px;
      line-height: 21px;
      font-variation-settings: 'wght' 330;
    }
    .row-title span {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .arrow {
      flex: none;
      width: 20px;
      height: 20px;
      color: var(--n-10);
    }
    .row-date {
      flex: none;
      font-size: 14px;
      line-height: 21px;
      font-weight: 300;
      color: var(--n-70);
    }
  }
</style>
