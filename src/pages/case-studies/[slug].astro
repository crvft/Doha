---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Img from '@/components/Img.astro';
import BackButton from '@/components/BackButton.astro';
import Button from '@/components/Button.astro';
import Figure from '@/components/mdx/Figure.astro';
import VideoBlock from '@/components/mdx/VideoBlock.astro';
import Callout from '@/components/mdx/Callout.astro';
import { inline, block } from '@/lib/md';
import { longDate } from '@/lib/format';

export async function getStaticPaths() {
  const entries = await getCollection('caseStudies', (e) => !e.data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);

const h2s = headings.filter((h) => h.depth <= 3);
const norm = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
const toc = (d.toc.length ? d.toc : h2s.filter((h) => h.depth === 2).map((h) => ({ label: h.text, heading: h.text })))
  .map((t) => ({ label: t.label, slug: h2s.find((h) => norm(h.text) === norm(t.heading))?.slug }))
  .filter((t) => t.slug);
---

<Base title={d.seoTitle || d.title} description={d.summary}>
  <div class="cs">
    <nav class="sidebar" aria-label="Case study">
      <BackButton href="/case-studies" />
      {
        toc.length > 0 && (
          <div class="contents appear" style="--appear-delay:1.5s; --appear-dur:.8s">
            <p class="contents-label">Contents</p>
            <ul>
              {toc.map((t) => (
                <li>
                  <a href={`#${t.slug}`}>
                    <span class="dot" aria-hidden="true" />
                    <span class="t">{t.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </nav>

    {
      d.hero && (
        <div class="mobile-hero appear" style="--appear-delay:1.1s">
          <Img src={d.hero} alt="" sizes="100vw" maxWidth={810} priority />
        </div>
      )
    }

    <article class="col">
      <header class="head">
        {
          d.hero && (
            <div class="hero appear" style="--appear-delay:1.1s">
              <Img src={d.hero} alt="" sizes="650px" maxWidth={650} priority />
            </div>
          )
        }
        <div class="title">
          <h1>{d.title}</h1>
          <time datetime={d.date.toISOString().slice(0, 10)}>{longDate(d.date)}</time>
        </div>
      </header>

      <div class="body">
        {
          (d.glance.length > 0 || d.tldr.length > 0) && (
            <section class="card glance appear" style="--appear-delay:.2s; --appear-dur:1s; --appear-y:4px">
              {d.glance.length > 0 && (
                <>
                  <h2 class="card-h">At a Glance</h2>
                  <div class="details">
                    {d.glance.map((g) => (
                      <p set:html={`${inline(g.label)}: ${inline(g.value)}`} />
                    ))}
                  </div>
                </>
              )}
              {d.tldr.length > 0 && (
                <>
                  <h2 class="card-h tldr-h">TL;DR</h2>
                  <ul class="tldr">
                    {d.tldr.map((t) => (
                      <li set:html={inline(t)} />
                    ))}
                  </ul>
                </>
              )}
            </section>
          )
        }

        {
          d.download && (
            <section class="card download appear" style="--appear-delay:.2s; --appear-dur:1s; --appear-y:4px">
              <h2 class="card-h dl-h">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                  <path d="M12 3v12M7 10l5 5 5-5M3 15v4a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {d.download.title}
              </h2>
              <div class="prose small" set:html={block(d.download.body)} />
              {d.download.url && (
                <div class="dl-btn">
                  <Button href={d.download.url}>{d.download.label || 'Download'}</Button>
                </div>
              )}
            </section>
          )
        }

        <div class="prose">
          <Content components={{ Figure, Video: VideoBlock, Callout }} />
        </div>
      </div>
    </article>
  </div>
</Base>

<style>
  .cs {
    position: relative;
    padding-bottom: 32px;
  }

  /* ── Sidebar (desktop ≥1200) ─────────────────────── */
  .sidebar {
    position: fixed;
    top: 62px;
    left: 92px;
    z-index: 2;
  }
  .contents {
    position: absolute;
    top: 120px;
    left: 0;
    width: 160px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .contents-label {
    font-family: var(--font-display);
    font-size: 16px;
    line-height: 22px;
    font-weight: 500;
    color: var(--n-10);
  }
  .contents ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .contents a {
    display: flex;
    align-items: center;
    height: 24px;
    gap: 0;
    color: var(--n-45);
    white-space: nowrap;
    transition:
      color var(--spring-soft-d) var(--spring-soft),
      gap var(--spring-soft-d) var(--spring-soft);
  }
  .contents .dot {
    width: 0;
    height: 4px;
    background: var(--red);
    transition: width var(--spring-soft-d) var(--spring-soft);
  }
  .contents .t {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @media (hover: hover) {
    .contents a:hover {
      color: var(--red);
      gap: 4px;
    }
    .contents a:hover .dot {
      width: 4px;
    }
  }

  /* ── Column ──────────────────────────────────────── */
  .col {
    width: 650px;
    max-width: 100%;
    margin: 0 auto;
    padding-top: 52px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .hero {
    position: relative;
    height: 350px;
    border-radius: 40px;
    overflow: hidden;
    background: var(--n-94);
    box-shadow: inset 0 0 0 1.2px var(--n-96);
    transform: translateZ(0);
  }
  .hero :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
  }
  .mobile-hero {
    display: none;
  }
  .title {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  h1 {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 24px;
    line-height: 30px;
    color: var(--n-10);
    font-variation-settings: 'wght' 480, 'wdth' 100;
    max-width: 606px;
  }
  time {
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 22px;
    color: var(--n-70);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px;
    border-radius: 20px;
    background: var(--n-98);
    box-shadow: inset 0 0 0 1px var(--n-96);
  }
  .card-h {
    font-size: 16px;
    line-height: 22px;
    font-weight: 400;
    color: var(--n-10);
  }
  .tldr-h {
    padding-top: 8px;
  }
  .details p {
    line-height: 22px;
    font-variation-settings: 'wght' 450;
  }
  .details :global(a),
  .tldr :global(a) {
    color: var(--n-25);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .tldr {
    margin: 0;
    padding-left: 19px;
  }
  .dl-h {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .dl-btn {
    display: flex;
    justify-content: flex-end;
    padding-top: 12px;
  }

  /* ── Rich text ───────────────────────────────────── */
  .prose {
    color: var(--n-45);
    overflow-wrap: break-word;
  }
  .prose :global(> * + *) {
    margin-top: 24px;
  }
  .prose :global(> h2) {
    font-size: 16px;
    line-height: 16px;
    font-weight: 500;
    color: var(--n-10);
    scroll-margin-top: 40px;
  }
  .prose :global(> h3) {
    font-size: 14px;
    line-height: 16px;
    font-weight: 500;
    color: var(--n-10);
    scroll-margin-top: 40px;
  }
  .prose :global(> :is(h2, h3) + *) {
    margin-top: 8px;
  }
  .prose :global(> p + :is(ul, ol)) {
    margin-top: 0;
  }
  .prose :global(> p + p) {
    margin-top: 22.5px;
  }
  .prose :global(strong) {
    font-weight: 500;
    color: var(--n-10);
  }
  .prose :global(a) {
    color: rgb(28, 130, 255);
    text-underline-offset: 2px;
  }
  @media (hover: hover) {
    .prose :global(a:hover) {
      text-decoration: underline;
    }
  }
  .prose :global(:is(ul, ol)) {
    margin-bottom: 0;
    padding-left: 19px;
  }
  .prose :global(ul ul) {
    list-style-type: circle;
  }
  .prose :global(li > p + *),
  .prose :global(li > ul) {
    margin-top: 22.5px;
  }
  .prose :global(li::marker),
  .tldr li::marker {
    color: var(--n-45);
  }
  .prose :global(ul > li::marker),
  .tldr li::marker {
    font-size: 11px;
  }
  .prose.small :global(> * + *) {
    margin-top: 0;
  }
  .prose.small :global(> p + :is(ul, ol)) {
    margin-top: 22.5px;
  }
  .prose :global(figure) {
    margin-block: 0;
  }

  /* ── Desktop S (1200–1439) ───────────────────────── */
  @media (max-width: 1439.98px) {
    .sidebar {
      left: 60px;
    }
  }
  /* ── Tablet & phone: no sidebar ──────────────────── */
  @media (max-width: 1199.98px) {
    .sidebar {
      display: none;
    }
  }
  /* ── Phone ───────────────────────────────────────── */
  @media (max-width: 809.98px) {
    .cs {
      padding-bottom: 72px;
    }
    .mobile-hero {
      display: block;
      position: relative;
      height: 250px;
      overflow: hidden;
      background: var(--n-96);
    }
    .mobile-hero :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .mobile-hero::after {
      content: '';
      position: absolute;
      inset: auto 0 0 0;
      height: 45%;
      background: linear-gradient(to bottom, rgba(255, 255, 255, 0), #fff 88%);
    }
    .hero {
      display: none;
    }
    .col {
      width: auto;
      padding: 10px 16px 0;
      gap: 40px;
    }
    h1 {
      font-size: 22px;
      line-height: 27px;
      letter-spacing: -0.15px;
    }
    time {
      color: var(--n-65);
    }
    .body {
      gap: 24px;
    }
    .glance {
      padding: 14px;
      gap: 8px;
    }
    .details p {
      line-height: 20.5px;
    }
  }
</style>
